# Copy to .env or set these as Windows environment variables before starting.
# Do not commit real credentials.
UPI_ALERT_RECIPIENT=admin@example.com
UPI_SMTP_HOST=smtp.gmail.com
UPI_SMTP_PORT=587
UPI_SMTP_USERNAME=your-sending-account@example.com
UPI_SMTP_PASSWORD=your-app-password
UPI_SMTP_FROM=your-sending-account@example.com
UPI_SMTP_STARTTLS=true
# Email is sent for a BLOCK result, or a score at/above this value.
UPI_EMAIL_SEVERE_RISK_THRESHOLD=70

# Security & Admin Settings
UPI_AUTH_SECRET=upi-fraud-detection-secure-key-2026
UPI_ADMIN_USER=admin
UPI_ADMIN_PASSWORD=admin123

# Database Configuration
UPI_DB_HOST=localhost
UPI_DB_PORT=3306
UPI_DB_USER=root
UPI_DB_PASSWORD=
UPI_DB_NAME=upi_fraud_db
