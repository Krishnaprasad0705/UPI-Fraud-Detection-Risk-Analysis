# ============================================================================
# UPI Fraud Detection System - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit real credentials to Git.
# ============================================================================

# --- Email Alert Recipient & Threshold ---
# Alerts are dispatched when classification is BLOCK or score >= threshold
ALERT_EMAIL_TO=2312024@nec.edu.in
UPI_ALERT_RECIPIENT=2312024@nec.edu.in
UPI_EMAIL_SEVERE_RISK_THRESHOLD=70

# --- SMTP Configuration (for Gmail, Outlook, AWS SES, or custom SMTP) ---
# For Gmail: Use smtp.gmail.com, port 587, STARTTLS enabled.
# NOTE: If 2-Factor Authentication is enabled on Gmail, generate a 16-character
# Google App Password from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sending-account@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-sending-account@gmail.com
UPI_SMTP_STARTTLS=true

# --- Security & JWT Secret Settings ---
UPI_AUTH_SECRET=upi-fraud-detection-secure-key-2026
UPI_ADMIN_USER=admin
UPI_ADMIN_PASSWORD=admin123

# --- Database Configuration (MySQL) ---
UPI_DB_HOST=localhost
UPI_DB_PORT=3306
UPI_DB_USER=root
UPI_DB_PASSWORD=your_mysql_password
UPI_DB_NAME=upi_fraud_db
